# csp for everything except kanboard
(csp) {
	header {args[0]} Content-Security-Policy "default-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
}

# security headers
(headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Permissions-Policy "accelerometer=(), ambient-light-sensor=(), autoplay=(), battery=(), bluetooth=(), browsing-topics=(), camera=(), display-capture=(), document-domain=(), encrypted-media=(), fullscreen=(), gamepad=(), geolocation=(), gyroscope=(), hid=(), identity-credentials-get=(), idle-detection=(), interest-cohort=(), keyboard-map=(), local-fonts=(), magnetometer=(), microphone=(), midi=(), otp-credentials=(), payment=(), picture-in-picture=(), publickey-credentials-create=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), speaker-selection=(), storage-access=(), sync-xhr=(), usb=(), web-share=(), window-management=(), xr-spatial-tracking=()"
		# browsers always check for a newer version first, no more stale pages
		Cache-Control "no-cache"
	}
}

toprakkilic.com {
	# basic server init
	root * /srv/www/toprakkilic.com
	encode
	import headers

	# exempt kanboard (it sends its own csp)
	@site not path /kanboard /kanboard/*
	import csp @site

	# kanboard (only place with php)
	handle /kanboard* {
		root * /srv/www

		# kanboard internals, nobody needs these
		@kbblocked path /kanboard/data/* /kanboard/app/* /kanboard/libs/* /kanboard/vendor/* /kanboard/tests/* /kanboard/.* /kanboard/config.php /kanboard/cli
		error @kbblocked 404

		php_fastcgi unix//run/php/php8.4-fpm.sock
		file_server
	}

	# directory listing for /files/, plain file server for everything else
	file_server /files/* {
		browse /srv/www/toprakkilic.com/config/browse.html
		hide .*
	}
	file_server

	# restricted access to non-public files, and no php outside kanboard
	@notpublic path /.git/* /README.md /LICENSE /.gitignore /404.html /config/* *.php
	error @notpublic 404
	header /.well-known/openpgpkey/* Access-Control-Allow-Origin "*"

	# redirects and clean urls
	redir /index.html / permanent
	redir /paths/now.html /now permanent
	redir /paths/uses.html /uses permanent
	redir /files /files/
	rewrite /now /paths/now.html
	rewrite /uses /paths/uses.html

	# force download for files, but not for directory listings
	@downloads {
		path /files/*
		not path */
	}
	header @downloads Content-Disposition attachment

	# listings use the folder's timestamp so browsers keep old pages, kill it
	@listing path_regexp ^/files/(.*/)?$
	header @listing -Last-Modified

	# 404 (root reset since kanboard swaps it)
	handle_errors 404 {
		root * /srv/www/toprakkilic.com
		import headers
		import csp *
		rewrite * /404.html
		file_server
	}
}

# mta-sts 
mta-sts.toprakkilic.com {
	root * /srv/www/toprakkilic.com
	import headers
	import csp *

	handle /.well-known/mta-sts.txt {
		file_server
	}
	handle {
		respond 404
	}
}

# wkd advanced method
openpgpkey.toprakkilic.com {
	root * /srv/www/toprakkilic.com
	import headers
	import csp *
	header Access-Control-Allow-Origin "*"

	handle /.well-known/openpgpkey/* {
		file_server
	}
	handle {
		respond 404
	}
}

# www goes to the main domain
www.toprakkilic.com {
	import headers
	redir https://toprakkilic.com{uri} permanent
}